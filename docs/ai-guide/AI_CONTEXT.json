  "summary": {
    "purpose": "Version and share portable user-scoped Codex Skills while excluding system and machine-local runtime state.",
    "architecture": [
      "The standalone repository contains one Skill package per directory and has no ProjectProfile or Active selection.",
      "The component leaf owns repository maintenance; a workflows shard owns specialized task Skills.",
      "Orientation, Context maintenance, scoped commits, and opt-in synchronization form the maintenance chain."
    ],
    "key_flows": [
      {
        "id": "context-flow",
        "summary": "Orientation gathers source evidence; ai-project-guide writes and validates durable Context.",
        "route_ids": [
          "maintain-context"
        ],
        "evidence_refs": [
          "orientation.skill",
          "context.skill"
        ],
        "confidence": "confirmed"
      },
      {
        "id": "commit-flow",
        "summary": "Exact changes become an approved local commit plan and only separately authorized synchronization.",
        "route_ids": [
          "commit-local-changes"
        ],
        "evidence_refs": [
          "commit.helper",
          "sync.skill"
        ],
        "confidence": "confirmed"
      },
      {
        "id": "workflow-routing",
